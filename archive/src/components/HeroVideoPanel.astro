---
import { whatsappUrl } from '../config';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

const trust = [
	{ icon: 'chat', label: 'Todo por WhatsApp' },
	{ icon: 'calendar-check', label: 'Cita con captura' },
	{ icon: 'phone', label: 'Pago por Yape' },
] as const;

const prep = [
	'Te decimos qué llevar y qué revisar antes de ir.',
	'Resolvemos tus dudas por WhatsApp.',
	'Tu cita queda lista a tu nombre.',
];
---

<Section
	flush
	data-hero
	class="hero relative isolate flex flex-col overflow-hidden pt-16 lg:justify-center lg:pt-0"
>
	<div class="hero-copy container-page relative z-10 order-3 pt-6 pb-12 md:pt-10 lg:order-none lg:pt-24 lg:pb-6 lg:tall:pt-28 lg:tall:pb-12">
		<SectionHeader
			level={1}
			align="left"
			eyebrow="Servicio privado de gestión · Lima"
			title="Tu cita para lunas polarizadas, sin vueltas"
			lead="Creamos tu usuario y tu cita, y te orientamos para el día del trámite. La cita es gratuita; cobramos la gestión."
		/>
		<div
			data-reveal-load
			style="--reveal-i: 3"
			class="mt-6 flex flex-col gap-3 whitespace-nowrap sm:flex-row sm:items-center lg:flex-col lg:items-start xl:flex-row xl:tall:mt-8 xl:flex-wrap xl:items-center"
		>
			<Button href={whatsappUrl()} whatsapp class="px-4 sm:px-6">Agenda tu cita por WhatsApp</Button>
			<Button href="#requisitos" variant="secondary">Ver requisitos</Button>
		</div>

		<ul
			data-reveal-load
			style="--reveal-i: 4"
			class="mt-8 grid gap-3 border-t border-border pt-6 text-body font-semibold text-primary sm:grid-cols-3 sm:gap-4 lg:mt-6 lg:grid-cols-1 lg:pt-5 lg:tall:mt-8 lg:tall:pt-6 xl:grid-cols-3 xl:tall:mt-10 xl:tall:pt-8"
		>
			{
				trust.map((item) => (
					<li class="flex items-center gap-3 sm:flex-col sm:items-start sm:gap-2 lg:flex-row lg:items-center lg:gap-3 xl:flex-col xl:items-start xl:gap-2">
						<Icon name={item.icon} size="lg" class="text-primary-soft" />
						{item.label}
					</li>
				))
			}
		</ul>

		<p data-reveal-load style="--reveal-i: 5" class="mt-6 text-body text-muted-foreground lg:mt-5 lg:tall:mt-6 xl:tall:mt-8">
			Cobramos solo por la gestión; la tasa oficial va aparte. No somos la PNP.
		</p>
	</div>


	<div
		class="car-stage showroom relative isolate order-1 h-[34svh] min-h-60 w-full shrink-0 overflow-hidden md:h-[44svh] md:min-h-96 lg:absolute lg:top-20 lg:right-0 lg:bottom-0 lg:order-none lg:h-auto lg:w-[54%] lg:rounded-tl-panel"
	>
		<!-- El video ocupa el ancho del panel y se funde arriba y abajo con el showroom.
		     La imagen es su primer cuadro: póster mientras carga y fallback si el video
		     falla, si el navegador bloquea el autoplay o con movimiento reducido. -->
		<div class="car-media absolute inset-x-0 aspect-3/2">
			<img
				src="/hero/auto-1080.webp"
				srcset="/hero/auto-720.webp 1080w, /hero/auto-1080.webp 1620w"
				sizes="(min-width: 64rem) 54vw, 100vw"
				alt="Sedán blanco de perfil al atardecer, con las lunas laterales y la posterior oscuras. Imagen referencial."
				width="1620"
				height="1080"
				decoding="async"
				fetchpriority="high"
				class="absolute inset-0 size-full object-cover"
			/>
			<video
				data-car-video
				muted
				loop
				playsinline
				preload="none"
				disablepictureinpicture
				aria-hidden="true"
				tabindex="-1"
				width="1620"
				height="1080"
				class="car-video absolute inset-0 size-full object-cover"
			>
			</video>
		</div>
	</div>

	<div
		class="hero-card card relative z-10 order-2 mx-gutter -mt-14 p-4 sm:mx-auto sm:w-full sm:max-w-md lg:absolute lg:right-8 lg:bottom-8 lg:order-none lg:mx-0 lg:mt-0 lg:w-80 lg:p-5"
	>
		<p class="font-heading font-semibold text-primary">Llega preparado al trámite</p>
		<ul role="list" class="mt-3 grid gap-2 text-small text-foreground">
			{
				prep.map((item) => (
					<li class="flex gap-2">
						<Icon name="check" class="mt-0.5 shrink-0 text-primary-soft" />
						{item}
					</li>
				))
			}
		</ul>
		<p class="mt-3 border-t border-border pt-2 text-small text-muted-foreground">
			Orientación para el día del trámite; la decisión es de la PNP.
		</p>
	</div>
</Section>

<style>
	.hero {
		min-height: 100svh;
	}

	/* El auto queda siempre por encima de la tarjeta: el borde inferior de las llantas
	   está al 88 % del alto del video (8cqw por debajo de ahí queda solo pista). */
	.car-stage {
		container-type: inline-size;
		--car-clear: 4.25rem;
	}

	.car-media {
		bottom: calc(var(--car-clear) - 8cqw);
		mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 90%, transparent);
	}

	/* El video aparece sobre el póster cuando ya está reproduciéndose. */
	.car-video {
		opacity: 0;
		transition: opacity 300ms linear;
	}

	[data-hero][data-playing] .car-video {
		opacity: 1;
	}

	/* Escritorio: alto con tope, para que en pantallas altas asome la sección siguiente
	   en vez de crecer el vacío alrededor del texto. La columna de texto ocupa el 46 % que deja libre el panel, arranca en la
	   misma línea que el logo del navbar (.container-wide) y guarda 3rem antes del panel. */
	@media (min-width: 64rem) {
		.hero {
			min-height: clamp(40rem, 100svh, 54rem);
		}

		.car-stage {
			--car-clear: 19.5rem;
		}

		.hero-copy {
			width: 46%;
			max-width: none;
			margin-inline: 0;
			padding-right: 3rem;
			padding-left: max(
				var(--spacing-gutter-lg),
				calc((100% - var(--container-wide)) / 2 + var(--spacing-gutter-lg))
			);
		}
	}

	@media (min-width: 90rem) {
		.hero-copy {
			padding-left: max(
				var(--spacing-gutter-xl),
				calc((100% - var(--container-wide)) / 2 + var(--spacing-gutter-xl))
			);
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-hero]');
	const video = root?.querySelector<HTMLVideoElement>('[data-car-video]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

	function start(root: HTMLElement, video: HTMLVideoElement) {
		// 720p en móvil y tablet, 1080p desde lg. WebM (VP9) primero; MP4 (H.264) de respaldo.
		const size = window.matchMedia('(min-width: 64rem)').matches ? '1080' : '720';
		for (const [ext, type] of [
			['webm', 'video/webm; codecs="vp9"'],
			['mp4', 'video/mp4'],
		]) {
			const source = document.createElement('source');
			source.src = `/hero/auto-${size}.${ext}`;
			source.type = type;
			video.append(source);
		}

		// Si el video falla o el navegador bloquea el autoplay, queda el póster.
		const showPoster = () => delete root.dataset.playing;
		video.addEventListener('playing', () => (root.dataset.playing = ''));
		video.addEventListener('error', showPoster);
		video.lastElementChild?.addEventListener('error', showPoster);

		// Solo se reproduce mientras el hero está en pantalla.
		new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting) video.play().catch(showPoster);
			else video.pause();
		}).observe(root);
	}

	if (root && video && !reduceMotion && !saveData) {
		// Carga diferida: el video solo se pide cuando el hero entra en pantalla.
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				start(root, video);
			},
			{ rootMargin: '200px' },
		);
		observer.observe(root);
	}
</script>
