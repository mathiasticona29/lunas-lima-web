---
import { whatsappUrl } from '../config';
import Button from './Button.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

const ctaUrl = whatsappUrl('Hola, quiero agendar mi cita para lunas polarizadas. ¿Me ayudan?');
---

<Section id="contacto" tone="primary" class="showroom" aria-labelledby="cta-final-titulo">
	<SectionHeader
		onDark
		eyebrow="Empieza hoy"
		title="Agenda tu cita y llega con tranquilidad"
		lead="Escríbenos y te contamos cómo gestionamos tu cita."
		titleId="cta-final-titulo"
	/>
	<div data-reveal class="mt-10 flex flex-col items-start gap-3 md:items-center">
		<Button href={ctaUrl} whatsapp class="w-full sm:w-auto">Pide tu cita por WhatsApp</Button>
		<p class="text-small text-on-primary/80">
			Servicio privado de gestión; no somos la PNP. La tasa oficial va aparte.
		</p>
	</div>
</Section>
