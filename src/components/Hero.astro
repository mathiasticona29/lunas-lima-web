---
import { whatsappUrl } from '../config';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

const trust = [
	{ icon: 'chat', label: 'Todo por WhatsApp' },
	{ icon: 'calendar-check', label: 'Cita con captura' },
	{ icon: 'wallet', label: 'Yape, Plin o banco' },
] as const;

const prep = [
	'Te decimos qué llevar y qué revisar antes de ir.',
	'Resolvemos tus dudas por WhatsApp.',
	'Tu cita queda lista a tu nombre.',
];
---

<Section
	flush
	data-hero
	class="hero relative isolate flex flex-col overflow-hidden pt-16 text-on-primary lg:justify-center lg:pt-0"
>
	<!-- Fondo: el video a sangre, debajo del navbar. En móvil va arriba, entero y a todo el
	     ancho (en vertical no cabría el auto), y se funde con el marino sobre el que sigue
	     el texto. La imagen es su primer cuadro: póster mientras carga y fallback si el
	     video falla, si el navegador bloquea el autoplay o con movimiento reducido. -->
	<div class="hero-stage absolute inset-x-0 top-16 bottom-0 -z-10 bg-primary-deep lg:top-20">
		<div class="hero-media absolute inset-x-0 top-0">
			<picture>
				<source media="(min-width: 64rem)" srcset="/hero/auto-wide-1080.webp" width="1920" height="1080" />
				<img
					src="/hero/auto-720.webp"
					alt="Sedán blanco de perfil al atardecer, con las lunas laterales y la posterior oscuras. Imagen referencial."
					width="1080"
					height="720"
					decoding="async"
					fetchpriority="high"
					class="hero-frame"
				/>
			</picture>
			<video
				data-car-video
				muted
				loop
				playsinline
				preload="none"
				disablepictureinpicture
				inert
				tabindex="-1"
				class="hero-frame car-video"
			>
			</video>
		</div>
	</div>

	<div class="hero-copy container-page relative pb-4 lg:pt-24 lg:pb-6 lg:tall:pt-28 lg:tall:pb-12">
		<!-- Panel oscuro semitransparente: asegura la lectura sobre cualquier parte del video. -->
		<div
			class="hero-text -mx-gutter px-gutter py-5 md:-mx-gutter-lg md:px-gutter-lg lg:mx-0 lg:w-fit lg:rounded-card lg:p-6"
		>
			<SectionHeader
				level={1}
				align="left"
				onDark
				eyebrow="Servicio privado de gestión · Lima"
				title="Tu cita para lunas polarizadas, sin vueltas"
				lead="Creamos tu usuario y tu cita, y te orientamos para el día del trámite. La cita es gratuita; cobramos la gestión."
			/>
			<div
				data-reveal-load
				style="--reveal-i: 3"
				class="mt-6 flex flex-col gap-3 whitespace-nowrap sm:flex-row sm:items-center lg:flex-col lg:items-start xl:flex-row xl:flex-wrap xl:items-center"
			>
				<Button href={whatsappUrl()} whatsapp class="px-4 sm:px-6">Agenda tu cita por WhatsApp</Button>
				<Button href="#requisitos" variant="dark">Ver requisitos</Button>
			</div>

			<ul
				data-reveal-load
				style="--reveal-i: 4"
				class="mt-6 grid gap-3 border-t border-on-primary/25 pt-5 text-body font-semibold sm:grid-cols-3 sm:gap-4 lg:grid-cols-1 xl:grid-cols-3"
			>
				{
					trust.map((item) => (
						<li class="flex items-center gap-3 sm:flex-col sm:items-start sm:gap-2 lg:flex-row lg:items-center lg:gap-3 xl:flex-col xl:items-start xl:gap-2">
							<Icon name={item.icon} size="lg" />
							{item.label}
						</li>
					))
				}
			</ul>

			<p data-reveal-load style="--reveal-i: 5" class="mt-5 text-body text-on-primary/80">
				Nuestra gestión: S/ 30. Tasa oficial: S/ 71.40, aparte y la pagas tú. No somos la PNP.
			</p>
		</div>
	</div>

	<!-- Solo desde lg, flotando sobre el video. En móvil y tablet no se muestra: alargaba
	     el hero más allá del CTA y repite lo que explican las secciones siguientes. -->
	<div class="hero-card card hidden lg:absolute lg:right-8 lg:bottom-8 lg:block lg:w-80 lg:p-5">
		<p class="font-heading font-semibold text-primary">Llega preparado al trámite</p>
		<ul role="list" class="mt-3 grid gap-2 text-small text-foreground">
			{
				prep.map((item) => (
					<li class="flex gap-2">
						<Icon name="check" class="mt-0.5 shrink-0 text-primary-soft" />
						{item}
					</li>
				))
			}
		</ul>
		<p class="mt-3 border-t border-border pt-2 text-small text-muted-foreground">
			Orientación para el día del trámite; la decisión es de la PNP.
		</p>
	</div>
</Section>

<style>
	.hero {
		--hero-shade: var(--color-primary-deep);
	}

	/* Móvil y tablet: el video ocupa el ancho en 3:2 y su borde inferior se funde con el
	   marino; el texto arranca sobre la pista, justo debajo de las llantas. El hero mide lo
	   que su contenido (sin alto mínimo), para que no sobre marino bajo la línea de aviso. */
	.hero-media {
		aspect-ratio: 3 / 2;
		mask-image: linear-gradient(to bottom, #000 88%, transparent);
	}

	@media (max-width: 63.999rem) {
		.hero-copy {
			padding-top: calc(100vw * 2 / 3 * 0.87);
		}
	}

	.hero-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* El video aparece sobre el póster cuando ya está reproduciéndose. */
	.car-video {
		opacity: 0;
		transition: opacity 300ms linear;
	}

	[data-hero][data-playing] .car-video {
		opacity: 1;
	}

	.hero-text {
		background-color: color-mix(in srgb, var(--hero-shade) 72%, transparent);
	}

	/* Sobre el panel el anillo de foco va en claro. */
	.hero-copy :global(:focus-visible) {
		outline-color: var(--color-on-primary);
	}

	/* Escritorio: el hero ocupa toda la primera pantalla, sin tope de alto, para que el
	   video llegue hasta el borde inferior y no asome la sección siguiente. El video llena
	   todo el hero; la columna de texto flota encima, a la izquierda, en la misma línea
	   que el logo del navbar (.container-wide). */
	@media (min-width: 64rem) {
		.hero {
			min-height: max(40rem, 100svh);
		}

		.hero-media {
			bottom: 0;
			aspect-ratio: auto;
			mask-image: none;
		}

		/* En pantallas más angostas que 16:9 se recorta el lado izquierdo (queda bajo el texto). */
		.hero-frame {
			object-position: 70% 85%;
		}

		.hero-copy {
			width: 46%;
			max-width: none;
			margin-inline: 0;
			padding-right: 3rem;
			padding-left: max(
				var(--spacing-gutter-lg),
				calc((100% - var(--container-wide)) / 2 + var(--spacing-gutter-lg))
			);
		}

		/* El panel sobresale lo que mide su padding: el texto sigue alineado con el logo. */
		.hero-text {
			margin-left: -1.5rem;
		}
	}

	@media (min-width: 90rem) {
		.hero-copy {
			padding-left: max(
				var(--spacing-gutter-xl),
				calc((100% - var(--container-wide)) / 2 + var(--spacing-gutter-xl))
			);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.car-video {
			transition: none;
		}
	}
</style>

<script>
	const root = document.querySelector<HTMLElement>('[data-hero]');
	const video = root?.querySelector<HTMLVideoElement>('[data-car-video]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;

	function start(root: HTMLElement, video: HTMLVideoElement) {
		// 3:2 a 720p en móvil y tablet; 16:9 a 1080p desde lg. WebM (VP9) primero; MP4 de respaldo.
		const name = window.matchMedia('(min-width: 64rem)').matches ? 'auto-wide-1080' : 'auto-720';
		for (const [ext, type] of [
			['webm', 'video/webm; codecs="vp9"'],
			['mp4', 'video/mp4'],
		]) {
			const source = document.createElement('source');
			source.src = `/hero/${name}.${ext}`;
			source.type = type;
			video.append(source);
		}

		// Si el video falla o el navegador bloquea el autoplay, queda el póster.
		const showPoster = () => delete root.dataset.playing;
		video.addEventListener('playing', () => (root.dataset.playing = ''));
		video.addEventListener('error', showPoster);
		video.lastElementChild?.addEventListener('error', showPoster);

		// Solo se reproduce mientras el hero está en pantalla.
		new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting) video.play().catch(showPoster);
			else video.pause();
		}).observe(root);
	}

	if (root && video && !reduceMotion && !saveData) {
		// Carga diferida: el video solo se pide cuando el hero entra en pantalla.
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				observer.disconnect();
				start(root, video);
			},
			{ rootMargin: '200px' },
		);
		observer.observe(root);
	}
</script>
