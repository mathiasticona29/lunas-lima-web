---
import Icon from './Icon.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

interface FaqList {
	/** Frase de entrada, terminada en dos puntos. */
	intro: string;
	items: string[];
}

interface Faq {
	q: string;
	/** Respuesta de un párrafo. Admite HTML (enlaces). */
	a?: string;
	/** Respuesta enumerada: una o más listas y una frase de cierre (ver DESIGN.md §6). */
	lists?: FaqList[];
	closing?: string;
}

const faqs: Faq[] = [
	{
		q: '¿Ustedes son la PNP?',
		a: 'No. Somos un servicio privado de gestión: creamos tu usuario y tu cita, y te orientamos. No actuamos en nombre de la PNP ni tenemos vínculo oficial con ella.',
	},
	{
		q: '¿La cita tiene costo?',
		a: 'La cita es gratuita. Lo que cobramos es nuestra gestión: S/ 30. La tasa oficial va aparte: son S/ 71.40, que pagas tú en el Banco de la Nación (código 08362) y debes tener lista antes de empezar.',
	},
	{
		q: '¿Cómo pago?',
		a: 'Puedes pagar la gestión por Yape, Plin o transferencia bancaria; te indicamos los datos por WhatsApp. La tasa oficial se paga aparte, directamente en el Banco de la Nación.',
	},
	{
		q: '¿Cuánto demora conseguir la cita?',
		a: 'Depende de la disponibilidad. Hoy las citas disponibles están a unos 2 a 3 meses. Te avisamos por WhatsApp apenas tengamos novedades.',
	},
	{
		q: '¿Garantizan que me aprueben el permiso?',
		a: 'No. La decisión es de la PNP y nadie puede asegurarla. Gestionamos tu cita y te orientamos para que llegues preparado.',
	},
	{
		q: 'Vivo fuera de Lima, ¿puedo hacer el trámite?',
		a: 'La cita, el trámite y el peritaje son presenciales y solo en Lima, con tu vehículo. Si vives en otra ciudad, tendrás que viajar a Lima el día de tu cita. Por eso conviene elegir la fecha con calma; te orientamos antes de agendar.',
	},
	{
		q: '¿Qué pasa si no puedo ir el día de mi cita?',
		a: 'Nosotros no podemos reprogramar la cita. Si no puedes asistir, debes acercarte personalmente a informes en el local de la PNP. Para evitarlo, confirma tu disponibilidad antes de agendar y te ayudamos a elegir una fecha que te convenga.',
	},
	{
		q: '¿Puedo hacerlo yo mismo?',
		a: 'Sí, puedes hacer el trámite por tu cuenta. Nuestro servicio es para quien prefiere que otros se encarguen del registro y lo orienten.',
	},
	{
		q: '¿Qué pasa con mis datos personales?',
		a: 'Los usamos solo para gestionar tu cita y los eliminamos 30 días después de ella, conforme a la Ley 29733 de protección de datos personales. Detalles en nuestra <a href="/privacidad/">política de privacidad</a>.',
	},
	{
		q: '¿Por qué necesitan un código de mi correo?',
		a: 'Es la verificación que hace el sistema para crear tu usuario. Te llega a tu correo y solo tienes que reenviárnoslo por WhatsApp apenas llegue; nosotros hacemos el resto.',
	},
	{
		q: 'No me llega el código, ¿qué hago?',
		a: 'El sistema puede demorar. Espera y no pidas otro, porque se puede trabar. Escríbenos por WhatsApp y te avisamos qué hacer.',
	},
	{
		// Resumen del art. 14 del D.S. 004-2019-IN: no añadir, quitar ni reformular supuestos.
		q: '¿Quién no puede obtener el permiso?',
		lists: [
			{
				intro: 'Según el artículo 14 del D.S. 004-2019-IN, la PNP no otorga la autorización si el propietario tiene:',
				items: [
					'antecedentes policiales, penales o judiciales;',
					'denuncias activas y en trámite por accidentes de tránsito o como presunto autor de delitos contra el patrimonio, la libertad o la seguridad pública, de terrorismo o de tráfico ilícito de drogas;',
					'una requisitoria o mandato de detención.',
				],
			},
			{
				intro: 'Tampoco si el vehículo:',
				items: [
					'está requerido por mandato judicial;',
					'tiene orden de captura;',
					'tiene modificado, alterado o borrado el número de identificación de fábrica;',
					'tiene vencidos sus documentos de porte obligatorio (salvo la licencia de conducir).',
				],
			},
		],
		closing: 'Eso lo evalúa la PNP, no nosotros.',
	},
];
---

<Section id="faq" tone="card" aria-labelledby="faq-titulo">
	<SectionHeader
		eyebrow="Preguntas frecuentes"
		title="Lo que suelen preguntarnos"
		lead="Si tu duda no está aquí, escríbenos por WhatsApp."
		titleId="faq-titulo"
	/>

	<div class="mx-auto mt-10 max-w-3xl border-b border-border">
		{
			faqs.map((faq) => (
				<details data-reveal class="faq border-t border-border">
					<summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-4 font-heading font-semibold text-primary">
						<span class="text-body lg:text-h3">{faq.q}</span>
						<Icon name="chevron-down" class="faq-chevron text-primary-soft" />
					</summary>
					{faq.lists ? (
						<div class="faq-answer flex max-w-2xl flex-col gap-4 pb-5 text-muted-foreground">
							{faq.lists.map((list) => (
								<div>
									<p>{list.intro}</p>
									<ul class="mt-2 flex list-disc flex-col gap-1 pl-5">
										{list.items.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</div>
							))}
							{faq.closing && <p>{faq.closing}</p>}
						</div>
					) : (
						<p class="faq-answer max-w-2xl pb-5 text-muted-foreground" set:html={faq.a} />
					)}
				</details>
			))
		}
	</div>
</Section>

<style>
	.faq summary::-webkit-details-marker {
		display: none;
	}

	.faq-chevron {
		transition: transform 180ms var(--ease-out-soft);
	}

	.faq[open] .faq-chevron {
		transform: rotate(180deg);
	}

	.faq-answer :global(a) {
		color: var(--color-primary-soft);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-chevron {
			transition: none;
		}
	}
</style>
