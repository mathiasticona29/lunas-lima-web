---
import { whatsappUrl } from '../config';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

const ctaUrl = whatsappUrl('Hola, quiero contratar la gestión de mi cita. ¿Cómo procedemos?');

// Los [VERIFICAR] son datos por confirmar; no reemplazar por cifras inventadas.
const incluye = [
	'Creación de tu usuario y tu cita',
	'Revisión de tus datos antes de agendar',
	'Captura de tu cita confirmada',
	'Orientación para el día del trámite',
	'Atención de dudas por WhatsApp',
];

const noIncluye = [
	'La tasa oficial de la PNP (S/ [VERIFICAR] monto vigente)',
	'La instalación del polarizado',
	'Garantía de que el permiso sea aprobado',
];
---

<Section id="precios" tone="background" aria-labelledby="precios-titulo">
	<SectionHeader
		eyebrow="Precio"
		title="Un solo precio por la gestión"
		lead="Pagas por que nosotros gestionemos tu cita y te orientemos. La cita en sí es gratuita."
		titleId="precios-titulo"
	/>

	<div
		data-reveal
		class="card card-featured mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-[1fr_1.25fr] md:gap-0 md:p-8 lg:mt-14"
	>
		<div class="flex flex-col md:pr-8">
			<h3 class="text-h3 font-semibold lg:text-h3-lg">Gestión de cita para permiso de lunas polarizadas</h3>
			<p class="mt-4 font-heading text-h1 font-bold whitespace-nowrap text-primary">S/ [VERIFICAR]</p>
			<p class="mt-2 text-small text-muted-foreground">Solo por la gestión; la tasa oficial va aparte.</p>
			<p class="mt-4 flex items-center gap-3 text-muted-foreground">
				<Icon name="phone" class="text-primary-soft" />
				Pago por Yape. Otros medios: [VERIFICAR].
			</p>
			<div class="mt-6 md:mt-auto md:pt-8">
				<Button href={ctaUrl} whatsapp class="w-full">Agenda tu cita</Button>
			</div>
		</div>

		<div class="border-t border-border pt-6 md:border-t-0 md:border-l md:pt-0 md:pl-8">
			<h4 class="eyebrow">Incluye</h4>
			<ul role="list" class="mt-3 flex flex-col gap-3">
				{
					incluye.map((item) => (
						<li class="flex gap-3">
							<Icon name="check" class="mt-0.5 text-primary-soft" />
							<span>{item}</span>
						</li>
					))
				}
			</ul>
			<h4 class="eyebrow mt-6 border-t border-border pt-6 text-muted-foreground">No incluye</h4>
			<ul role="list" class="mt-3 flex flex-col gap-3 text-muted-foreground">
				{
					noIncluye.map((item) => (
						<li class="flex gap-3">
							<Icon name="minus" class="mt-0.5" />
							<span>{item}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>

	<p data-reveal class="mx-auto mt-6 max-w-2xl text-small text-muted-foreground md:text-center">
		El precio es solo por la gestión. La tasa oficial se paga aparte y la decisión sobre el permiso es de la PNP.
	</p>
</Section>
