---
import { whatsappUrl } from '../config';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

const ctaUrl = whatsappUrl('Hola, quiero contratar la gestión de mi cita. ¿Cómo procedemos?');

const incluye = [
	'Creación de tu usuario y tu cita',
	'Revisión de tus datos antes de agendar',
	'Captura de tu cita confirmada',
	'Orientación para el día del trámite',
	'Atención de dudas por WhatsApp',
];

const noIncluye = [
	'La tasa oficial (S/ 71.40): la pagas tú en el Banco de la Nación',
	'La instalación del polarizado',
	'Garantía de que el permiso sea aprobado',
];
---

<Section id="precios" tone="background" aria-labelledby="precios-titulo" data-wa-float-hide>
	<SectionHeader
		eyebrow="Precio"
		title="Un solo precio por la gestión"
		lead="Pagas por que nosotros gestionemos tu cita y te orientemos. La cita en sí es gratuita."
		titleId="precios-titulo"
	/>

	<div
		data-reveal
		class="card card-featured mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-[1fr_1.25fr] md:gap-0 md:p-8"
	>
		{/* Orden del DOM = orden en móvil: precio → listas → CTA. Desde md el CTA sube a la
		    columna izquierda, bajo el precio: las listas ocupan las dos filas y el sobrante se
		    reparte entre ambas, así que precio (abajo) y CTA (arriba) quedan centrados juntos. */}
		<div class="flex flex-col md:col-start-1 md:row-start-1 md:self-end md:pr-8">
			<h3 class="text-h3 font-semibold lg:text-h3-lg">Gestión de cita para permiso de lunas polarizadas</h3>
			<p class="mt-4 font-heading text-h1 font-bold whitespace-nowrap text-primary">S/ 30</p>
			<p class="mt-2 text-small text-muted-foreground">Solo por la gestión; la tasa oficial va aparte.</p>
			<p class="mt-4 flex items-start gap-3 text-muted-foreground">
				<Icon name="wallet" class="mt-0.5 text-primary-soft" />
				Pagas por Yape, Plin o transferencia bancaria.
			</p>
		</div>

		<div
			class="border-t border-border pt-6 md:col-start-2 md:row-span-2 md:row-start-1 md:border-t-0 md:border-l md:pt-0 md:pl-8"
		>
			<h4 class="eyebrow">Incluye</h4>
			<ul role="list" class="mt-3 flex flex-col gap-3">
				{
					incluye.map((item) => (
						<li class="flex gap-3">
							<Icon name="check" class="mt-0.5 text-primary-soft" />
							<span>{item}</span>
						</li>
					))
				}
			</ul>
			<h4 class="eyebrow mt-6 border-t border-border pt-6 text-muted-foreground">No incluye</h4>
			<ul role="list" class="mt-3 flex flex-col gap-3 text-muted-foreground">
				{
					noIncluye.map((item) => (
						<li class="flex gap-3">
							<Icon name="minus" class="mt-0.5" />
							<span>{item}</span>
						</li>
					))
				}
			</ul>
		</div>

		<div class="border-t border-border pt-6 md:col-start-1 md:row-start-2 md:self-start md:border-t-0 md:pr-8">
			<Button href={ctaUrl} whatsapp class="w-full">Agenda tu cita</Button>
		</div>
	</div>

	<p data-reveal class="mx-auto mt-6 max-w-2xl text-small text-muted-foreground md:text-center md:text-balance">
		Ten en cuenta: las citas salen a unos 2 a 3 meses, son solo en Lima y presenciales, y no podemos
		reprogramarlas. La decisión del permiso es de la PNP.
	</p>
</Section>
