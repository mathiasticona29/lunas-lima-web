---
import type { HTMLAttributes } from 'astro/types';

// Íconos de línea sobre una grilla de 24. Para añadir uno, agrega aquí sus trazos.
const paths = {
	bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z" />',
	'calendar-check':
		'<path d="M8 3v3m8-3v3M4 10h16M6 5h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /><path d="m9 15.5 2 2 4-4" />',
	phone:
		'<path d="M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z" /><path d="M11 18h2" />',
	chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12Z" />',
	'clipboard-check':
		'<path d="M9 4H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2" /><path d="M9 3h6v3H9z" /><path d="m9 13.5 2 2 4-4" />',
	menu: '<path d="M4 7h16M4 12h16M4 17h16" />',
	close: '<path d="M6 6l12 12M18 6 6 18" />',
	'arrows-horizontal': '<path d="M4 12h16M8 8l-4 4 4 4M16 8l4 4-4 4" />',
	wallet:
		'<path d="M5 6h12a2 2 0 0 1 2 2v1H6a2 2 0 0 1 0-4h11" /><path d="M4 7v10a2 2 0 0 0 2 2h13a1 1 0 0 0 1-1v-8a1 1 0 0 0-1-1M16 14h.5" />',
	check: '<path d="m5 12.5 4.5 4.5L19 7.5" />',
	minus: '<path d="M6 12h12" />',
	'chevron-down': '<path d="m6 9 6 6 6-6" />',
	'id-card':
		'<path d="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /><path d="M9 13a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm-3 3a3 3 0 0 1 6 0m3-6h3m-3 3.5h3" />',
	car: '<path d="M5 11 6.6 6.9A2 2 0 0 1 8.5 5.5h7a2 2 0 0 1 1.9 1.4L19 11m-14 0h14a2 2 0 0 1 2 2v4H3v-4a2 2 0 0 1 2-2Zm0 6v1.5m14-1.5v1.5M7 14h1.5m7 0H17" />',
	mail: '<path d="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" /><path d="m3.5 7.5 8.5 6 8.5-6" />',
	'shield-check':
		'<path d="M12 3 5 5.5v6c0 4.2 2.9 7.6 7 9.5 4.1-1.9 7-5.3 7-9.5v-6L12 3Z" /><path d="m9 12 2 2 4-4" />',
};

export type IconName = keyof typeof paths;

interface Props extends HTMLAttributes<'svg'> {
	name: IconName;
	/** xs 16 px (dentro de texto pequeño) · sm 24 px · md 28 px (marcador) · lg 32 px (destacado) */
	size?: 'xs' | 'sm' | 'md' | 'lg';
}

const { name, size = 'sm', class: className, ...rest } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	aria-hidden="true"
	class:list={['icon', size !== 'sm' && `icon-${size}`, className]}
	set:html={paths[name]}
	{...rest}
/>
