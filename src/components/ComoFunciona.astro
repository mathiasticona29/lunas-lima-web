---
import { whatsappUrl } from '../config';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

const ctaUrl = whatsappUrl('Hola, vi cómo funciona el servicio y quiero empezar con mi cita');

const steps = [
	{
		icon: 'chat',
		title: 'Envíanos tus datos',
		text: 'Escríbenos por WhatsApp y comparte tus documentos y datos de contacto.',
	},
	{
		icon: 'calendar-check',
		title: 'Te agendamos la cita',
		text: 'Gestionamos tu usuario y tu cita. Te llegará un código a tu correo: solo reenvíanoslo por WhatsApp apenas llegue. Luego te enviamos la captura de confirmación.',
	},
	{
		icon: 'clipboard-check',
		title: 'Llega preparado',
		text: 'Te orientamos sobre qué llevar y qué esperar el día del trámite.',
	},
] as const;

// Conversación ilustrativa: sin nombres, horas ni datos reales (ver DESIGN.md, Mockups).
const chat = [
	{ from: 'cliente', text: 'Hola, quiero gestionar mi cita.' },
	{ from: 'nosotros', text: 'Hola. Envíanos tus documentos por aquí.' },
	{ from: 'nosotros', text: 'Creamos tu usuario. Te llegará un código al correo.' },
	{ from: 'cliente', text: 'Ya me llegó. Te lo reenvío.' },
	{ from: 'nosotros', text: 'Listo, tu cita quedó agendada.' },
] as const;

const citaFields = ['Titular', 'Vehículo', 'Fecha y hora', 'Sede'];
---

<Section id="como-funciona" tone="background" aria-labelledby="como-funciona-titulo">
	<SectionHeader
		eyebrow="Cómo funciona"
		title="Tres pasos y tu cita queda agendada"
		lead="Tú nos escribes; nosotros nos encargamos de la parte engorrosa."
		titleId="como-funciona-titulo"
	/>

	<div class="mt-10 grid gap-10 lg:grid-cols-[1fr_28rem] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-16 lg:gap-y-0">
		<ol role="list" class="mx-auto w-full max-w-md lg:col-start-1 lg:row-start-1 lg:mx-0 lg:max-w-none">
			{
				steps.map((step, index) => (
					<li data-reveal class="step relative flex gap-4 pb-8 last:pb-0 lg:gap-6 lg:pb-10">
						<div class="relative flex size-14 shrink-0 items-center justify-center rounded-full bg-muted">
							<Icon name={step.icon} size="md" class="text-primary-soft" />
							<span
								aria-hidden="true"
								class="absolute -top-1 -right-1 flex size-6 items-center justify-center rounded-full bg-primary font-heading text-small font-semibold text-on-primary"
							>
								{index + 1}
							</span>
						</div>
						<div class="pt-1">
							<h3 class="text-h3 font-semibold lg:text-h3-lg">{step.title}</h3>
							<p class="mt-1 max-w-md text-muted-foreground">{step.text}</p>
						</div>
					</li>
				))
			}
		</ol>

		<figure class="mockup mx-auto w-full max-w-md lg:col-start-2 lg:row-span-2 lg:row-start-1">
			<figcaption class="flex items-center justify-between gap-3 border-b border-border pb-3 text-small text-muted-foreground">
				<span class="font-heading font-semibold text-primary">Conversación</span>
				<span class="rounded-full border border-border bg-card px-3 py-1 font-semibold whitespace-nowrap text-foreground">
					Ejemplo ilustrativo
				</span>
			</figcaption>
			<ul role="list" class="mt-3 flex flex-col gap-2">
				{
					chat.map((message) => (
						<li
							data-reveal
							class:list={['bubble', message.from === 'cliente' ? 'bubble-out' : 'bubble-in']}
						>
							<span class="sr-only">{message.from === 'cliente' ? 'Cliente: ' : 'Lunas Lima: '}</span>
							{message.text}
						</li>
					))
				}
				<li data-reveal class="bubble bubble-in w-full">
					<span class="sr-only">Lunas Lima envía la captura de la cita: </span>
					<p class="flex items-center gap-2 font-heading font-semibold text-primary">
						<Icon name="calendar-check" class="text-primary-soft" />
						Cita agendada
					</p>
					<dl class="mt-2 grid grid-cols-[auto_1fr_auto_1fr] items-center gap-x-3 gap-y-2 border-t border-border pt-2 text-small text-muted-foreground">
						{
							citaFields.map((field, index) => (
								<>
									<dt>{field}</dt>
									<dd>
										<span
											aria-hidden="true"
											class:list={['block h-2.5 rounded-full bg-muted', index % 2 ? 'w-3/4' : 'w-full']}
										/>
										<span class="sr-only">dato de tu cita</span>
									</dd>
								</>
							))
						}
					</dl>
				</li>
			</ul>
			<p class="mt-3 text-small text-muted-foreground">
				No es una conversación real ni un documento oficial. La decisión sobre el permiso es de la PNP.
			</p>
		</figure>

		<!-- Desde lg el CTA cierra la columna de los pasos, alineada arriba con el mockup (DESIGN.md §2). -->
		<div data-reveal class="flex flex-col items-start gap-3 md:items-center lg:col-start-1 lg:row-start-2 lg:mt-10 lg:items-start">
			<Button href={ctaUrl} whatsapp class="w-full sm:w-auto">Pide tu cita por WhatsApp</Button>
			<p class="text-small text-muted-foreground">Servicio privado de gestión; no somos la PNP.</p>
		</div>
	</div>
</Section>

<style>
	/* Línea conectora vertical: bajo el marcador, hasta el paso siguiente. */
	.step:not(:last-child)::before {
		content: '';
		position: absolute;
		top: 3.5rem;
		bottom: 0;
		left: calc(1.75rem - 1px);
		width: 2px;
		background-color: var(--color-border);
	}
</style>
