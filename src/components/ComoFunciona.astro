---
import { whatsappUrl } from '../config';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

const ctaUrl = whatsappUrl('Hola, vi cómo funciona y quiero agendar mi cita');

const steps = [
	{
		icon: 'chat',
		title: 'Envíanos tus datos',
		text: 'Escríbenos por WhatsApp y pásanos tu DNI, tarjeta de propiedad, correo y celular.',
	},
	{
		icon: 'calendar-check',
		title: 'Te agendamos la cita',
		text: 'Nos encargamos del registro y te enviamos la captura de tu cita confirmada.',
	},
	{
		icon: 'clipboard-check',
		title: 'Llega preparado',
		text: 'Te orientamos para el día del trámite: qué llevar y cómo es el peritaje.',
	},
] as const;
---

<Section id="como-funciona" tone="card" aria-labelledby="como-funciona-titulo">
	<SectionHeader
		eyebrow="Cómo funciona"
		title="Tres pasos y tu cita queda agendada"
		lead="Tú nos escribes; nosotros nos encargamos de la parte engorrosa."
		titleId="como-funciona-titulo"
	/>

	<ol role="list" class="mt-10 md:grid md:grid-cols-3 md:gap-8 lg:mt-14">
		{
			steps.map((step, index) => (
				<li
					data-reveal
					class="step relative flex gap-4 pb-8 last:pb-0 md:flex-col md:items-center md:pb-0 md:text-center"
				>
					<div class="relative flex size-14 shrink-0 items-center justify-center rounded-full bg-muted">
						<Icon name={step.icon} size="md" class="text-primary-soft" />
						<span
							aria-hidden="true"
							class="absolute -top-1 -right-1 flex size-6 items-center justify-center rounded-full bg-primary font-heading text-small font-semibold text-on-primary"
						>
							{index + 1}
						</span>
					</div>
					<div class="pt-1 md:pt-0">
						<h3 class="text-h3 font-semibold lg:text-h3-lg">{step.title}</h3>
						<p class="mt-1 text-muted-foreground md:mx-auto md:max-w-xs">{step.text}</p>
					</div>
				</li>
			))
		}
	</ol>

	<div data-reveal class="mt-10 flex flex-col items-start gap-3 md:items-center lg:mt-14">
		<Button href={ctaUrl} whatsapp class="w-full sm:w-auto">Empieza por WhatsApp</Button>
		<p class="text-small text-muted-foreground">Servicio privado de gestión; no somos la PNP.</p>
	</div>
</Section>

<style>
	/* Línea conectora: vertical en móvil (bajo el marcador, hasta el paso siguiente)... */
	.step:not(:last-child)::before {
		content: '';
		position: absolute;
		top: 3.5rem;
		bottom: 0;
		left: calc(1.75rem - 1px);
		width: 2px;
		background-color: var(--color-border);
	}

	/* ...y horizontal en escritorio, de marcador a marcador (2rem = gap de la grilla). */
	@media (min-width: 48rem) {
		.step:not(:last-child)::before {
			top: calc(1.75rem - 1px);
			bottom: auto;
			left: calc(50% + 1.75rem);
			width: calc(100% + 2rem - 3.5rem);
			height: 2px;
		}
	}
</style>

